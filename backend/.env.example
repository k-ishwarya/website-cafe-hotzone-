# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to GitHub.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hotzone?retryWrites=true&w=majority

# Long random string — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Admin login credentials (used once by createAdmin.js to seed the DB)
ADMIN_USERNAME=
ADMIN_PASSWORD=
RECOVERY_PIN=

# Server port (Railway sets this automatically, safe to leave as-is locally)
PORT=5000
